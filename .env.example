# Names and placeholders only: never a real value. Copy to .env for local runs.
BOOKING_URL=http://localhost:3001
# The worker's own service token (svc-worker), issued by Identity. Required.
SERVICE_TOKEN=
EXPIRE_EVERY=60s
PENDING_TTL=15m
BATCH_SIZE=100
RUN_TIMEOUT=50s
HTTP_TIMEOUT=5s
HTTP_ATTEMPTS=3
HTTP_BACKOFF=200ms
